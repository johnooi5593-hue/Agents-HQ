{
  "name": "agents-hq",
  "productName": "Agents HQ",
  "version": "1.0.0",
  "description": "Agents HQ desktop app: starts the office engine and shows the 3D office in one window",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnooi5593-hue/Agents-HQ.git"
  },
  "author": "Agents HQ",
  "scripts": {
    "start": "electron .",
    "test": "node test-lib.js",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.agentshq.desktop",
    "productName": "Agents HQ",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib.js",
      "setup.html",
      "phone.html",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "bundle",
        "to": "office",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Agents HQ",
      "artifactName": "Agents-HQ-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Agents-HQ-Portable.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    }
  }
}
