      "Bash(python3 .claude/skills/pixel/scripts/thumbnail.py:*)",
      "Bash(mkdir -p out/:*)",
      "Bash(mkdir -p work/:*)",
      "Bash(mv inbox/*)",
      "Bash(cp * inbox/)",
