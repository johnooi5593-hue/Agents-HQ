      "Edit(//d/website-builds/**)",
      "Write(//d/website-builds/**)",
      "Edit(//d/website-private/**)",
      "Write(//d/website-private/**)",
      "Edit(//d/website-tools/**)",
      "Write(//d/website-tools/**)",
      "Edit(//d/$RECYCLE.BIN/**)",
      "Write(//d/$RECYCLE.BIN/**)",
      "Edit(//d/System Volume Information/**)",
      "Write(//d/System Volume Information/**)",
      "Edit(//g/**)",
      "Write(//g/**)",
      "Edit(//w/**)",
      "Write(//w/**)"
