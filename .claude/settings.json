    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "D:\\",
      "G:\\",
      "W:\\"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hq/events.js start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hq/events.js stop"
          }
        ]
      }
    ]
  },
  "model": "claude-opus-5-5"
}
