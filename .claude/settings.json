      "Bash(*api/accounts*)",
      "Edit(//d/*.*)",
      "Write(//d/*.*)",
      "Edit(//d/2026_PROJECTS/**)",
      "Write(//d/2026_PROJECTS/**)",
      "Edit(//d/AI OFFICE/**)",
      "Write(//d/AI OFFICE/**)",
      "Edit(//d/CODEX/**)",
      "Write(//d/CODEX/**)",
      "Edit(//d/CodexBuildCache/**)",
      "Write(//d/CodexBuildCache/**)",
      "Edit(//d/Instech/**)",
      "Write(//d/Instech/**)",
      "Edit(//d/OneDriveTemp/**)",
      "Write(//d/OneDriveTemp/**)",
      "Edit(//d/PSAutoRecover/**)",
      "Write(//d/PSAutoRecover/**)",
      "Edit(//d/Users/**)",
      "Write(//d/Users/**)",
      "Edit(//d/Vercel Deploy/**)",
      "Write(//d/Vercel Deploy/**)",
      "Edit(//d/pk-test/**)",
      "Write(//d/pk-test/**)",
      "Edit(//d/pk-work/**)",
      "Write(//d/pk-work/**)",
      "Edit(//d/website/**)",
